function beadKey(s){
  if(s.location.includes('crucifix'))return 'cross';
  if(s.location==='First large bead')return 'intro-large';
  let intro=s.location.match(/Introductory small bead (\d)/);
  if(intro)return 'intro-'+intro[1];
  let decade=s.location.match(/Decade (\d): (large bead|small bead (\d+))/);
  if(decade)return 'd'+decade[1]+'-'+(decade[2]==='large bead'?'0':decade[3]);
  if(s.title.includes('Mystery —')){
    let n=ord.findIndex(x=>s.title.startsWith(x));
