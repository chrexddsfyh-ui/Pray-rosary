   const clip=node('clipPath',{id:clipId},defs);
   node('circle',{cx:b.x,cy:b.y,r:r-.55},clip);
   node('circle',{cx:b.x,cy:b.y,r,
     fill:`url(#${b.large?'woodDark':'woodLight'})`,
     stroke:'#57331e','stroke-width':.85},g);
   const grain=node('g',{'clip-path':`url(#${clipId})`,opacity:.38},g);
   // Subtle curved organic grain in every bead, deterministic for a stable appearance.
   for(let j=-2;j<=2;j++){
     const dx=j*2.8+(b.seed%3-1)*.6;
     const x=b.x+dx;
     node('path',{d:`M${x-2} ${b.y-r-1} Q${x+2.8} ${b.y-2} ${x-.6} ${b.y+r+1}`,
       fill:'none',stroke:j%2?'#e5ac70':'#482517',
       'stroke-width':j===0?.85:.48},grain);
   }
   node('ellipse',{cx:b.x-r*.26,cy:b.y-r*.33,rx:r*.29,ry:r*.17,
     fill:'#f7d2a0',opacity:.42},g);
   node('circle',{cx:b.x,cy:b.y,r:r-.65,fill:'none',
     stroke:'#e9b681','stroke-width':.4,opacity:.4},g);
 }
 beads.forEach(bead);
 intro.forEach(bead);
 const medalActive=active==='medal';
 if(medalActive)halo(220,365,12,15.3);
 node('ellipse',{cx:220,cy:365,rx:12,ry:15.3,fill:'url(#metal)',
   stroke:'#6b4b29','stroke-width':1.2,filter:'url(#woodShadow)'});
 node('ellipse',{cx:220,cy:365,rx:8.6,ry:11.6,fill:'none',stroke:'#e9c993','stroke-width':.8});
 const m=node('text',{x:220,y:370,'text-anchor':'middle','font-family':'Georgia,serif',
   'font-size':14,'font-style':'italic',fill:'#fce6b6'});
 m.textContent='M';
 const crossActive=active==='cross';
 if(crossActive){
   // The original silhouette traces every arm, corner and edge of the crucifix.
   // Glow is rendered behind the photograph, not as a circle or a visible outline.
   const g=node('g',{class:'active-halo'});
   [
     {width:13,opacity:.82,filter:'url(#glowWide)',color:'#ffd68a'},
     {width:7,opacity:.9,filter:'url(#glowMedium)',color:'#ffc56d'},
     {width:2.8,opacity:.8,filter:'url(#glowTight)',color:'#ffe5a6'}
   ].forEach(l=>node('path',{d:CRUCIFIX_OUTLINE,transform:'translate(0 87)',
     fill:'none',stroke:l.color,'stroke-width':l.width,opacity:l.opacity,
     filter:l.filter,'stroke-linejoin':'round','stroke-linecap':'round'},g));
 }

 // Your own crucifix photo, isolated from its background and packaged with this site.
 node('image',{href:'data:image/png;base64,',x:203,y:546,width:34,height:63,
   preserveAspectRatio:'xMidYMid meet',filter:'url(#woodShadow)'});

}
function render(){
 const s=steps[index], key=beadKey(s);
 document.getElementById('heading').textContent=s.title;
 document.getElementById('location').textContent=s.location;
 document.getElementById('prayer').textContent=s.text;
 document.getElementById('tip').textContent=s.tip;
 document.getElementById('tip').hidden=!s.tip;
 document.getElementById('reflection').hidden=!s.reflect;
 document.getElementById('reflection').textContent=s.reflect?'Meditate on this: '+s.reflect:'';
 document.getElementById('progressLabel').textContent=`Step ${index+1} of ${steps.length}`;
 document.getElementById('percent').textContent=Math.round((index+1)/steps.length*100)+'%';
 document.getElementById('progressBar').style.width=(index+1)/steps.length*100+'%';
 document.getElementById('back').disabled=index===0;
 document.getElementById('next').textContent=index===steps.length-1?'Start again ↺':'Next →';
 document.getElementById('beadStatus').textContent=key==='cross'?'Crucifix':key==='medal'?'Center medal':s.location;
 drawRosary(key);
 storage.setItem('rosaryStep',index);
}
document.getElementById('next').addEventListener('click',()=>{
 index=index===steps.length-1?0:index+1;render();
});
document.getElementById('back').addEventListener('click',()=>{
 index=Math.max(0,index-1);render();
});
document.getElementById('mysterySet').addEventListener('change',e=>{
 selected=e.target.value;storage.setItem('rosarySet',selected);
 build(selected);index=0;render();
});
document.getElementById('reset').addEventListener('click',()=>{index=0;render()});
document.getElementById('allMysteries').innerHTML=Object.entries(sets).map(([key,items])=>`<h3>${key[0].toUpperCase()+key.slice(1)} mysteries</h3><ol>${items.map(x=>`<li>${x[0]}</li>`).join('')}</ol>`).join('');
render();
</script></body></html>
